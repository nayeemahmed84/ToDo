rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isListOwner(listId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/lists/$(listId)).data.ownerUid == request.auth.uid;
    }

    function isListMember(listId) {
      let listData = get(/databases/$(database)/documents/lists/$(listId)).data;
      return isSignedIn()
        && (listData.ownerUid == request.auth.uid || (listData.memberUids != null && request.auth.uid in listData.memberUids));
    }

    match /{path=**}/items/{itemId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read, update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /lists/{listId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids));
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']));
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /items/{itemId} {
        allow read, write: if isListMember(listId);
        allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      }

      match /shares/{shareId} {
        allow read, write: if isListMember(listId);
      }
    }
  }
}
