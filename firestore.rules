rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function listMembers(data) {
      return ('memberUids' in data && data.memberUids is list) ? data.memberUids : [];
    }

    function isOwnerOfData(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    function isMemberOfData(data) {
      return isSignedIn() && (request.auth.uid in listMembers(data));
    }

    function isListOwner(listId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/lists/$(listId)).data.ownerUid == request.auth.uid;
    }

    function isListMember(listId) {
      let listData = get(/databases/$(database)/documents/lists/$(listId)).data;
      return isSignedIn()
        && (listData.ownerUid == request.auth.uid || (request.auth.uid in listMembers(listData)));
    }

    function isSelfJoinUpdate() {
      let oldMembers = listMembers(resource.data);
      let newMembers = request.resource.data.memberUids;
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && newMembers is list
        && request.auth.uid in newMembers
        && oldMembers.toSet().difference(newMembers.toSet()).size() == 0
        && newMembers.toSet().difference(oldMembers.toSet()).hasOnly([request.auth.uid])
        && ((request.auth.uid in oldMembers && newMembers == oldMembers)
            || (!(request.auth.uid in oldMembers) && newMembers.size() == oldMembers.size() + 1));
    }

    function isSelfLeaveUpdate() {
      let oldMembers = listMembers(resource.data);
      let newMembers = request.resource.data.memberUids;
      return isMemberOfData(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && newMembers is list
        && newMembers.toSet().difference(oldMembers.toSet()).size() == 0
        && oldMembers.toSet().difference(newMembers.toSet()).hasOnly([request.auth.uid])
        && !(request.auth.uid in newMembers)
        && newMembers.size() < oldMembers.size();
    }

    function isMemberAppearanceUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return isMemberOfData(resource.data)
        && affected.hasOnly(['color', 'background', 'customBackgroundActive'])
        && (!affected.hasAny(['customBackgroundActive'])
            || request.resource.data.customBackgroundActive == false);
    }

    function isOwnerListUpdate() {
      return isOwnerOfData(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (!('memberUids' in request.resource.data)
            || request.resource.data.memberUids == null
            || request.resource.data.memberUids is list);
    }

    match /{path=**}/items/{itemId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /groups/{groupId} {
      allow read, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /fcmTokens/{tokenId} {
        allow read, write, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /private/{docId} {
        allow read, write, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /icalFeeds/{tokenId} {
      allow get: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /lists/{listId} {
      allow read: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid
            || (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids));
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (!('memberUids' in request.resource.data)
            || request.resource.data.memberUids == null
            || request.resource.data.memberUids is list);
      allow update: if isOwnerListUpdate()
        || isSelfJoinUpdate()
        || isSelfLeaveUpdate()
        || isMemberAppearanceUpdate();
      allow delete: if isOwnerOfData(resource.data);

      match /items/{itemId} {
        allow read: if isListMember(listId);
        allow create: if isListMember(listId)
          && request.resource.data.listId == listId
          && request.resource.data.ownerUid == request.auth.uid;
        allow update: if isListMember(listId)
          && request.resource.data.listId == listId
          && (!('listId' in resource.data) || resource.data.listId == listId)
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isListOwner(listId)
          || (isListMember(listId) && resource.data.ownerUid == request.auth.uid);
      }

      match /shares/{shareId} {
        allow read: if isListMember(listId);
        allow create, update, delete: if isListOwner(listId);
      }

      match /presence/{presenceUid} {
        allow read: if isListMember(listId);
        allow create, update: if isListMember(listId)
          && request.auth.uid == presenceUid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isListMember(listId)
          && request.auth.uid == presenceUid;
      }
    }
  }
}
